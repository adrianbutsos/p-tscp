{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tscp.example/contracts/benchmark-request.schema.json",
  "title": "TSCP Benchmark Request Contract",
  "type": "object",
  "required": ["request_contract_version", "request", "organization", "configuration", "active_campaigns", "active_platforms", "benchmark_sources", "deliverable"],
  "properties": {
    "request_contract_version": {"type": "string"},
    "request": {
      "type": "object",
      "required": ["id", "created_at", "trigger", "planning_period", "lookback", "language"],
      "properties": {
        "id": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"},
        "trigger": {"enum": ["scheduled", "on_demand"]},
        "planning_period": {"$ref": "#/$defs/date_period"},
        "lookback": {"type": "object", "required": ["days", "end"], "properties": {"days": {"type": "integer", "minimum": 1}, "end": {"type": "string", "format": "date"}}, "additionalProperties": false},
        "language": {"type": "string", "minLength": 2}
      },
      "additionalProperties": false
    },
    "organization": {"type": "object"},
    "configuration": {"type": "object", "required": ["source_of_truth", "notion_admin_page_url", "local_fallback_files"], "properties": {"source_of_truth": {"enum": ["notion", "local_json"]}, "notion_admin_page_url": {"type": "string", "format": "uri"}, "local_fallback_files": {"type": "array", "minItems": 1, "items": {"type": "string"}}}, "additionalProperties": false},
    "active_campaigns": {"type": "array", "items": {"type": "object"}},
    "active_platforms": {"type": "array", "items": {"type": "object"}},
    "benchmark_sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "name", "type", "platforms", "search_queries"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "type": {"type": "string"}, "platforms": {"type": "array", "items": {"type": "string"}}, "search_queries": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "enabled": {"type": "boolean"}}, "additionalProperties": true}},
    "deliverable": {"type": "object", "required": ["benchmark_snapshot_path", "required_contract", "required_fields"], "properties": {"benchmark_snapshot_path": {"type": "string"}, "required_contract": {"type": "string"}, "required_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}}}, "additionalProperties": false}
  },
  "$defs": {
    "date_period": {"type": "object", "required": ["start", "end"], "properties": {"start": {"type": "string", "format": "date"}, "end": {"type": "string", "format": "date"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
